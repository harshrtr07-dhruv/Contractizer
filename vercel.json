{
  "builds": [
    {
      "src": "contract-risk-analyzer/backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "contract-risk-analyzer/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(auth|upload|analyze|report)(.*)",
      "destination": "/contract-risk-analyzer/backend/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/contract-risk-analyzer/frontend/$1"
    }
  ]
}
